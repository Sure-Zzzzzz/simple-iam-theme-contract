{
  "name": "@sure-zzzzzz/simple-iam-theme-contract",
  "version": "1.0.0",
  "description": "Versioned IAM theme tokens, TypeScript contracts, and safe custom-theme validation for microfrontends.",
  "license": "Apache-2.0",
  "author": "surezzzzzz",
  "type": "module",
  "sideEffects": [
    "./src/theme.css"
  ],
  "files": [
    "dist",
    "src/theme.css",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./Button": {
      "types": "./dist/components/Button.vue.d.ts",
      "import": "./dist/components/Button.js"
    },
    "./Pagination": {
      "types": "./dist/components/Pagination.vue.d.ts",
      "import": "./dist/components/Pagination.js"
    },
    "./Dialog": {
      "types": "./dist/components/Dialog.vue.d.ts",
      "import": "./dist/components/Dialog.js"
    },
    "./Drawer": {
      "types": "./dist/components/Drawer.vue.d.ts",
      "import": "./dist/components/Drawer.js"
    },
    "./PageHeader": {
      "types": "./dist/components/PageHeader.vue.d.ts",
      "import": "./dist/components/PageHeader.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && vue-tsc -p tsconfig.declarations.json && node scripts/rewrite-dts.mjs",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run type-check && npm run lint && npm run test:coverage && npm run build",
    "release:verify": "node scripts/release-verify.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "iam",
    "theme",
    "design-tokens",
    "microfrontend",
    "qiankun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sure-Zzzzzz/simple-iam-theme-contract.git"
  },
  "bugs": {
    "url": "https://github.com/Sure-Zzzzzz/simple-iam-theme-contract/issues"
  },
  "homepage": "https://github.com/Sure-Zzzzzz/simple-iam-theme-contract#readme",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "2.1.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.0",
    "vite": "6.0.7",
    "vitest": "2.1.8",
    "vue": "3.5.13",
    "vue-tsc": "2.2.0"
  }
}
